<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The home-screen name. The bundle identifier, the executable and the
         URL scheme below are untouched: they are what the signature, the App
         Group and the installed keyboard are keyed to. -->
    <key>CFBundleDisplayName</key><string>Hushkey</string>
    <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
    <key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>0.1</string>
    <key>CFBundleVersion</key><string>1</string>
    <key>LSRequiresIPhoneOS</key><true/>
    <key>UILaunchScreen</key><dict/>
    <!-- SwiftUI's App lifecycle still needs a scene to be declared. Without this
         dictionary the app launches, connects no scene, and shows a white
         screen with no crash and nothing in the log. Xcode's generated
         Info.plist carries it (INFOPLIST_KEY_UIApplicationSceneManifest_Generation);
         this one is hand-written, so it has to be here explicitly. -->
    <key>UIApplicationSceneManifest</key>
    <dict>
      <key>UIApplicationSupportsMultipleScenes</key><false/>
    </dict>
    <!-- Portrait only on a phone: this app is a keyboard's companion, and a
         sentence typed into a rotated field is the one thing it must not do
         badly. The iPad list is separate because the check Xcode runs is about
         iPad multitasking, where an app that supports only one orientation must
         declare `UIRequiresFullScreen` -- and Hushkey deliberately does not:
         Slide Over and Split View are how it gets used beside the app the text
         is going into. So the iPad list carries all four, which is the honest
         answer for a window that can be resized. -->
    <key>UISupportedInterfaceOrientations</key>
    <array><string>UIInterfaceOrientationPortrait</string></array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <!-- File sharing, so models can be put on the phone at all. A phone has no
         shell: without these two keys the only way to install a 100 MB
         recogniser is the app's own importer, and a user told "the folder is
         empty" had nothing to open. With them the app appears under Finder ›
         iPhone › Files › Hushkey and under the Files app, and `models/` can be
         dragged straight in. -->
    <key>UIFileSharingEnabled</key><true/>
    <key>LSSupportsOpeningDocumentsInPlace</key><true/>
    <!-- Mode 2 lives inside a picture-in-picture window: without this the system
         suspends the app the moment it is backgrounded and the window closes
         with it. `audio` is the only mode PiP accepts for a call-style window. -->
    <key>UIBackgroundModes</key>
    <array><string>audio</string></array>
    <key>NSMicrophoneUsageDescription</key>
    <string>錄音並在本機轉成文字。音訊不離開這台裝置。</string>
    <key>CFBundleURLTypes</key>
    <array>
      <dict>
        <key>CFBundleURLName</key><string>com.example.offlinevoiceassistant.ios</string>
        <key>CFBundleURLSchemes</key><array><string>ovc</string></array>
      </dict>
    </array>
</dict>
</plist>
