<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The name a person reads. CFBundleExecutable and CFBundleIdentifier stay
         as they were: the first is a path every build script and the installed
         .app already depend on, and the second is what the Accessibility grant is
         keyed to -- changing it silently revokes the user's permission. -->
    <key>CFBundleName</key>
    <string>Hushkey</string>
    <key>CFBundleDisplayName</key>
    <string>Hushkey</string>
    <key>CFBundleIdentifier</key>
    <string>com.example.offlinevoiceassistant</string>
    <key>CFBundleExecutable</key>
    <string>OfflineVoiceAssistant</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <key>LSUIElement</key>
    <true/>
    <key>NSMicrophoneUsageDescription</key>
    <string>Records your voice for on-device speech recognition. Audio never leaves this Mac.</string>
    <key>NSAudioCaptureUsageDescription</key>
    <string>Records what this Mac is playing (the other people on a call) so meeting notes cover both sides. Audio is never muted or sent anywhere.</string>
    <key>NSCalendarsFullAccessUsageDescription</key>
    <string>Reads the title of the meeting happening right now, so a recording is named after it. Only the title is used; event contents are not read.</string>
    <key>NSCalendarsUsageDescription</key>
    <string>Reads the title of the meeting happening right now, so a recording is named after it. Only the title is used; event contents are not read.</string>
    <key>NSHighResolutionCapable</key>
    <true/>
</dict>
</plist>
